---
import { Image } from "astro:assets";
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";

interface Props {
  config: StoreConfig;
  content?: StoreFrontContent;
}
const { config, content } = Astro.props;
const year = new Date().getFullYear();

const badges = [
  { icon: "heroicons:credit-card", title: content?.trust1Title ?? "", sub: content?.trust1Sub ?? "" },
  { icon: "heroicons:truck",       title: content?.trust2Title ?? "", sub: content?.trust2Sub ?? "" },
  { icon: "heroicons:bolt",        title: content?.trust3Title ?? "", sub: content?.trust3Sub ?? "" },
];
---

<footer class="pdp-footer mt-8 pb-16 sm:pb-4">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8">
      {/* Brand Column */}
      <div class="md:col-span-4 space-y-3">
        <a href="/" class="flex items-center gap-3 active:scale-95 transition-transform">
          {config.logoUrl ? (
            <Image
              src={config.logoUrl}
              alt={config.name}
              width={120}
              height={32}
              format="webp"
              quality={90}
              class="h-8 w-auto object-contain"
              loading="lazy"
            />
          ) : (
            <span class="pdp-footer-brand">{config.name}</span>
          )}
        </a>
        <p class="pdp-footer-link text-[0.8125rem] sm:text-[0.875rem] font-medium leading-relaxed max-w-sm">
          {content?.footerAbout}
        </p>
      </div>

      {/* Links Columns */}
      <div class="md:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-6">
        <div>
          <h3 class="pdp-footer-heading">{content?.footerQuickLinks}</h3>
          <ul class="space-y-2.5">
            {[
              { label: content?.navHome, href: "/" },
              { label: content?.navProducts, href: "/products" },
              { label: content?.navNewArrivals, href: "/products" },
              { label: content?.navBestSellers, href: "/products" },
            ].map((link) => (
              <li>
                <a href={link.href} class="pdp-footer-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="pdp-footer-heading">{content?.footerSupport}</h3>
          <ul class="space-y-2.5">
            {[
              { label: content?.footerShipping },
              { label: content?.footerReturns },
              { label: content?.navContact },
            ].map((link) => (
              <li>
                <span class="pdp-footer-link cursor-pointer">{link.label}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="col-span-2 sm:col-span-1">
          <h3 class="pdp-footer-heading">{content?.trust1Title}</h3>
          <div class="space-y-2.5">
            {badges.map((b) => (
              <div class="flex items-center gap-2.5 group">
                <div class="pdp-footer-badge-icon">
                  <Icon name={b.icon} class="w-4 h-4" />
                </div>
                <div class="min-w-0">
                  <p class="pdp-footer-badge-title">{b.title}</p>
                  <p class="pdp-footer-badge-sub">{b.sub}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="pdp-footer-bottom mt-6 sm:mt-8 pt-4 sm:pt-5 text-center">
      <p class="pdp-footer-link text-[0.6875rem] sm:text-[0.75rem] font-bold">
        &copy; {year} {config.name}. {content?.footerRights}
      </p>
    </div>
  </div>
</footer>
