---
import type { Product, Offer } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";

interface Props {
  product: Product;
  basePrice: number;
  cur: string;
  offers: Offer[];
  content: StoreFrontContent;
}

const { product, basePrice, cur, offers, content } = Astro.props;
const productImage = product.coverImage?.src ?? product.images?.[0]?.src ?? "";

function fmt(n: number) {
  return n.toLocaleString("ar-DZ");
}
---

<div class="order-summary mt-5" id="order-summary">
  <details open class="competitor-summary-details">
    <summary>
      <span class="title">{content.summaryTitle}</span>
      <Icon name="heroicons:chevron-up" class="w-5 h-5 summary-chevron" style="color: var(--clr-primary)" aria-hidden="true" />
    </summary>

    <div class="summary-content">
      <!-- Product line box -->
      <div class="competitor-summary-product-box">
        <div class="flex items-center gap-3">
          {productImage && (
            <img
              id="summary-image"
              class="w-12 h-12 object-cover rounded-lg border border-[var(--clr-border)]"
              src={productImage}
              alt={product.name}
              loading="lazy"
            />
          )}
          <span class="font-bold text-sm text-[var(--clr-text)]">{product.name}</span>
          <span
            class="text-xs font-bold px-2 py-0.5 rounded text-white"
            style="background-color: var(--clr-primary)"
            id="summary-qty-label"
          >
            x1
          </span>
        </div>
        <span class="font-bold text-sm text-[var(--clr-text)]" id="summary-item-price">
          {fmt(basePrice)} {cur}
        </span>
      </div>

      <!-- Shipping row -->
      <div class="flex items-center justify-between py-2 text-sm font-semibold text-[var(--clr-text-2)]">
        <span>{content.shippingLabel}</span>
        <span id="summary-shipping" class="competitor-shipping-badge">
          {content.shippingCalculated}
        </span>
      </div>

      <!-- Offer rows -->
      {offers.map((offer) => {
        const isFreeShipping = offer.discountType === "free_shipping";
        const rewardLabel = offer.rewardProductName + (offer.rewardVariantLabel ? ` (${offer.rewardVariantLabel})` : "");
        return (
          <div id={`offer-row-${offer.id}`} class="hidden flex items-center justify-between py-1 text-sm font-bold text-[var(--clr-success)]">
            {isFreeShipping ? (
              <>
                <span>{content.shippingLabel}</span>
                <span>{content.offerFreeShippingBadge}</span>
              </>
            ) : (
              <>
                <span>{rewardLabel} × {offer.rewardQuantity}</span>
                <span>{content.offerFreeLabel}</span>
              </>
            )}
          </div>
        );
      })}

      <!-- Total Banner (Green solid box like competitor) -->
      <div class="competitor-summary-total-banner">
        <span>{content.totalLabel}</span>
        <span id="summary-total">{fmt(basePrice)} {cur}</span>
      </div>
    </div>
  </details>
</div>

<style>
  details:not([open]) .summary-chevron {
    transform: rotate(180deg);
  }
</style>
