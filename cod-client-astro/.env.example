# Build-time client env — consumed via astro:env/client (see src/lib/api.ts).
# `astro dev` always targets the local cod-server (http://localhost:8787), so no
# file edit is needed to develop. A production `astro build` bakes
# PUBLIC_API_URL from .env — copy this file to .env (gitignored) and set your
# deployed cod-server origin ONCE; you never switch it back to develop.
PUBLIC_API_URL="https://api.example.com"
